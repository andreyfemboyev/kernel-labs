{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KERNEL LAB",
  "version": "0.1.0-alpha",
  "identifier": "org.kernellab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"KERNEL//LAB","width":1240,"height":790,"minWidth":720,"minHeight":500}],
    "security": {"csp":"default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data:; font-src 'self' data:"}
  },
  "bundle": {"active":true,"targets":"all","icon":["icons/icon.png","icons/icon.ico"]}
}
